{
  "config": {
    "flow_title": "{device}",
    "step": {
      "discovery_confirm": {
        "description": "Give your fireplace a name.",
        "data": {
          "name": "[%key:common::config_flow::data::name%]"
        }
      },
      "user": {
        "description": "Enter the details of your fireplace.",
        "data_description": {
          "unique_id": "Use the dongle's lowercase MAC address (aa:bb:cc:dd:ee:ff), not its IP address. Keep this identity when changing networks."
        },
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "unique_id": "[%key:common::config_flow::data::unique_id%]"
        }
      },
      "reconfigure": {
        "description": "Change the host or port without changing the device identity.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect and receive a Proflame state snapshot."
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "already_in_progress": "[%key:common::config_flow::abort::already_in_progress%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]",
      "not_proflame_device": "The device did not provide an acknowledged Proflame state.",
      "reconfigure_successful": "The connection settings were updated."
    }
  },
  "entity": {
    "climate": {
      "climate": {
        "name": "Mode"
      }
    },
    "fan": {
      "fan": {
        "name": "Fan"
      }
    },
    "light": {
      "light": {
        "name": "Light"
      }
    },
    "number": {
      "burner": {
        "name": "Flame height"
      }
    },
    "sensor": {
      "free_heap": {
        "name": "Free heap"
      },
      "min_free_heap": {
        "name": "Min free heap"
      },
      "wifi_signal_str": {
        "name": "Wifi signal"
      }
    },
    "switch": {
      "fireplace": {
        "name": "Fireplace"
      }
    }
  }
}
